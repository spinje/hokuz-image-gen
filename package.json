{
  "name": "nano-banana-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for generating and editing images using the Nano Banana family of Google Gemini image models (Nano Banana 2 / 2 Lite / Pro)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "nano-banana",
    "gemini",
    "image-generation",
    "mcp-server"
  ],
  "author": "spinje",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinje/nano-banana-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/spinje/nano-banana-mcp-server/issues"
  },
  "homepage": "https://github.com/spinje/nano-banana-mcp-server#readme",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
