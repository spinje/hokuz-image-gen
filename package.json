{
  "name": "hokuz-image-gen",
  "version": "1.0.0",
  "description": "MCP server for generating and editing images with Google's Gemini (Nano Banana) and OpenAI's GPT Image models",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "hokuz",
    "gemini",
    "openai",
    "image-generation",
    "mcp-server"
  ],
  "author": "spinje",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinje/hokuz-image-gen.git"
  },
  "bugs": {
    "url": "https://github.com/spinje/hokuz-image-gen/issues"
  },
  "homepage": "https://github.com/spinje/hokuz-image-gen#readme",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
