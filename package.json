{
  "name": "nano-banana-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for generating and editing images using the Nano Banana family of Google Gemini image models (Nano Banana 2 / 2 Lite / Pro)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "nano-banana",
    "gemini",
    "image-generation",
    "ai"
  ],
  "author": "spinje",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinje/nano-banana-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/spinje/nano-banana-mcp-server/issues"
  },
  "homepage": "https://github.com/spinje/nano-banana-mcp-server#readme",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
